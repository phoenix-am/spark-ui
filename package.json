{
  "name": "spark",
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phoenix-am/spark-ui.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/phoenix-am/spark-ui/issues"
  },
  "homepage": "https://github.com/phoenix-am/spark-ui#readme",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @sparkwire/utils -w @sparkwire/styles -w @sparkwire/icons -w @sparkwire/system -w @sparkwire/core && npm run registry",
    "test": "jest",
    "lint": "lerna run lint",
    "clean": "lerna clean",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate:component": "plop component --plopfile ./generators/plopfile.js",
    "generate:icons": "node ./packages/icons/scripts/convert-svg-to-react.js",
    "build:icons": "cd ./packages/icons && npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "registry": "node scripts/build-registry.mjs && node scripts/build-docs.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --legacy-peer-deps --ignore-scripts",
    "release": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.24.7",
    "@babel/preset-react": "^7.24.7",
    "@changesets/cli": "^3.0.3",
    "@chromatic-com/storybook": "^1.6.1",
    "@storybook/addon-essentials": "^8.2.9",
    "@storybook/addon-interactions": "^8.2.9",
    "@storybook/addon-links": "^8.2.9",
    "@storybook/addon-onboarding": "^8.2.9",
    "@storybook/addon-postcss": "^2.0.0",
    "@storybook/addon-webpack5-compiler-swc": "^1.0.5",
    "@storybook/blocks": "^8.2.9",
    "@storybook/react": "^8.2.9",
    "@storybook/react-webpack5": "^8.2.9",
    "@storybook/test": "^8.2.9",
    "@svgr/cli": "^8.1.0",
    "@svgr/core": "^8.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/jest-axe": "^3.5.9",
    "babel": "latest",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^7.1.2",
    "eslint": "^8.0.0",
    "eslint-plugin-storybook": "^0.8.0",
    "jest": "^29.7.0",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "lerna": "^8.1.8",
    "plop": "^4.0.1",
    "prettier": "^2.0.0",
    "react-hook-form": "^7.92.0",
    "react-svg": "^16.1.34",
    "sass": "^1.77.8",
    "sass-loader": "^16.0.0",
    "storybook": "^8.2.9",
    "style-loader": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "private": true
}
