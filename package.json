{
  "name": "spark",
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phoenix-am/spark-ui.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/phoenix-am/spark-ui/issues"
  },
  "homepage": "https://github.com/phoenix-am/spark-ui#readme",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @sparkwire/utils -w @sparkwire/styles -w @sparkwire/icons -w @sparkwire/system -w @sparkwire/core && npm run registry",
    "test": "jest",
    "lint": "lerna run lint",
    "clean": "lerna clean",
    "generate:component": "plop component --plopfile ./generators/plopfile.js",
    "generate:icons": "node ./packages/icons/scripts/convert-svg-to-react.js",
    "build:icons": "cd ./packages/icons && npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "registry": "node scripts/build-registry.mjs && node scripts/build-docs.mjs && node scripts/build-api.mjs && node scripts/build-translations.mjs",
    "translations": "node scripts/build-translations.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --legacy-peer-deps --ignore-scripts && npm run registry",
    "release": "node scripts/publish.mjs",
    "docs": "vite --config site/vite.config.ts",
    "docs:build": "vite build --config site/vite.config.ts && node scripts/build-site-pages.mjs",
    "test:cli": "node --test packages/cli/test/cli.test.mjs",
    "size": "node scripts/size.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.24.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-react": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.65.1",
    "@svgr/cli": "^8.1.0",
    "@svgr/core": "^8.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/jest-axe": "^3.5.9",
    "@vitejs/plugin-react": "^5.2.0",
    "babel": "latest",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^7.1.2",
    "esbuild": "^0.21.5",
    "eslint": "^8.0.0",
    "fast-check": "^4.11.0",
    "jest": "^29.7.0",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "lerna": "^8.1.8",
    "marked": "^15.0.12",
    "plop": "^4.0.1",
    "postcss": "^8.5.33",
    "prettier": "^2.0.0",
    "react": "^18.3.1",
    "react-docgen-typescript": "^2.2.2",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.92.0",
    "react-router": "^7.18.6",
    "react-svg": "^16.1.34",
    "sass": "^1.77.8",
    "sass-loader": "^16.0.0",
    "style-loader": "^4.0.0",
    "sugar-high": "^2.7.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "vite": "^7.3.8"
  },
  "private": true
}
