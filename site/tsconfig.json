{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "baseUrl": "..",
    "paths": {
      "@sparkwire/core/base": ["packages/core/src/base"],
      "@sparkwire/*": ["packages/*/src"],
      "@/components/spark-ui/*": ["packages/core/src/*"]
    }
  },
  "include": ["src"]
}
