{
  "name": "@sparkwire/system",
  "version": "0.2.0",
  "description": "A styling engine for the Spark UI library.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "prepare": "npm run clean && npm run build",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "dependencies": {
    "@sparkwire/styles": "0.2.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "rimraf": "^3.0.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "license": "MIT",
  "keywords": [
    "spark-ui",
    "styling",
    "theme",
    "design-system"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phoenix-am/spark-ui.git",
    "directory": "packages/system"
  },
  "homepage": "https://github.com/phoenix-am/spark-ui#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
