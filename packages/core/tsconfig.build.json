{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "sourceMap": false,
    "declarationMap": false,
    "outDir": "dist/types",
    "rootDir": "src",
    "paths": {}
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.stories.tsx", "src/**/__tests__/**", "src/__docgen__/**", "src/**/*.test.tsx", "src/**/*.test.ts"]
}
